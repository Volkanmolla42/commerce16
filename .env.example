ADMIN_PIN=REPLACE_WITH_A_PRIVATE_6_DIGIT_PIN
# Keep this server-only value identical in Next.js and the Convex deployment.
ADMIN_API_SECRET=CHANGE_ME_TO_THE_SAME_RANDOM_SECRET_IN_NEXT_AND_CONVEX
# Public admin URL segment, for example yonetim23. The PIN remains required.
NEXT_PUBLIC_ADMIN_PATH=yonetim23


# Geliver credentials stay in the Convex deployment environment.
GELIVER_TOKEN=
GELIVER_SENDER_ADDRESS_ID=
GELIVER_SOURCE_IDENTIFIER=
# Start with simulated shipments; set to 0 only after confirming the account and addresses.
GELIVER_TEST_MODE=1
GELIVER_PACKAGE_LENGTH_CM=25
GELIVER_PACKAGE_WIDTH_CM=20
GELIVER_PACKAGE_HEIGHT_CM=10
GELIVER_PACKAGE_WEIGHT_KG=1

# Resend order emails use a sender address verified in your Resend account.
RESEND_API_KEY=
ORDER_FROM_EMAIL=

# Paraşüt v4 OAuth values stay in the Convex deployment environment.
# Obtain OAuth client values and the initial refresh token through Paraşüt onboarding.
EINVOICE_PROVIDER=parasut
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_COMPANY_ID=
PARASUT_INITIAL_REFRESH_TOKEN=
# 32 random bytes as 64 hex characters; encrypts rotating OAuth tokens stored in Convex.
PARASUT_TOKEN_ENCRYPTION_KEY=
# Set when checkout starts collecting delivery charges.
PARASUT_SHIPPING_VAT_RATE=
# Optional fallback adapter provider: EINVOICE_PROVIDER=adapter
EINVOICE_ADAPTER_URL=
EINVOICE_ADAPTER_TOKEN=

