ADMIN_PIN=REPLACE_WITH_A_PRIVATE_6_DIGIT_PIN
# Keep this server-only value identical in Next.js and the Convex deployment.
ADMIN_API_SECRET=CHANGE_ME_TO_THE_SAME_RANDOM_SECRET_IN_NEXT_AND_CONVEX
# Private admin URL segment (server-only secret, not exposed to storefront bundle).
# NEXT_PUBLIC_ADMIN_PATH is also supported for backward compatibility.
ADMIN_PATH=yonetim23


# Resend order emails use a sender address verified in your Resend account.
# These four values are Convex functions env (npx convex env set KEY=value).
RESEND_API_KEY=
# Sender for all transactional emails, e.g. "Mağaza <siparis@alanadin.com>"
ORDER_FROM_EMAIL=
# Recipient for internal alerts: new orders, contact form, low stock.
ADMIN_ALERT_EMAIL=
# Public site origin used in email links, e.g. https://alanadin.com
# Vercel'de zorunlu değil: uygulama VERCEL_PROJECT_PRODUCTION_URL ile üretim
# domain'ini otomatik bulur. Kendi domain'ine geçince buraya yaz.
SITE_URL=

# Meta (Facebook) Pixel ID (e.g. 1234567890123456)
NEXT_PUBLIC_META_PIXEL_ID=
